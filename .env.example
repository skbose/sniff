# Copy to .env and fill in your values

# Langfuse (optional — enables tracing if both are set)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# Your Anthropic API key — used for shadow (A/B) requests so they aren't
# routed through Claude Code's internal account (which restricts model access).
# The primary request always uses whatever key Claude Code sends.
ANTHROPIC_API_KEY=sk-ant-...

# Proxy settings (optional — defaults shown)
# SNIFF_PORT=8080
# SNIFF_LOG_DIR=./sniff-logs
# SNIFF_UPSTREAM=https://api.anthropic.com
